# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/qc_platform

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-in-production

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins - for distributed deployment
# Examples: ["http://192.168.1.10:3000"] or ["https://web.example.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=qc-platform

# Gemini
GEMINI_API_KEY=AIzaSyAV75Lnnc8GPVIvpnAE05BJRjWhJSgvT0U
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# NotebookLM API
NOTEBOOKLM_API_KEY=
NOTEBOOKLM_BASE_URL=https://notebooklm.google.com/api/v1

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@abachem.com

# Tesseract OCR
