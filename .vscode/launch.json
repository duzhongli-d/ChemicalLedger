{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行所有测试",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "apps/api/tests",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "运行当前测试文件",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "运行单个测试 (光标处)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}:${lineNumber}",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
